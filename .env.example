# Next.js App Environment Variables
NEXT_PUBLIC_APP_NAME="EventFlow ERP"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API & Database
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Prisma Database URL (Connects directly or via pooler to Supabase PostgreSQL)
# Direct connection (port 5432) or Transaction Pooler (port 6543)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Demo Mode: true allows seamless exploration with instant preloaded seed data
NEXT_PUBLIC_DEMO_MODE=true
